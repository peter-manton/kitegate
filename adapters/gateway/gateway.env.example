# Copy to gateway.env and fill in. gateway.env is ignored by git (*.env).

# Long random string; every front end sends it as its API key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KITEGATE_API_KEY=

# Where children's requests go. Directly to a provider:
KITEGATE_UPSTREAM_URL=https://api.openai.com/v1
KITEGATE_UPSTREAM_API_KEY=
KITEGATE_UPSTREAM_KIND=openai
# ...or through NeMo Guardrails (start Compose with --profile nemo):
# KITEGATE_UPSTREAM_URL=http://nemo:8000/v1
# KITEGATE_UPSTREAM_KIND=nemo

# alias=upstream model. Front ends show the alias.
KITEGATE_CHILD_MODELS=kids-encyclopedia=gpt-4.1-mini
KITEGATE_PACK=uk-school
# Packs a front end may pick per request (x-kitegate-pack). "*" = all bundled.
KITEGATE_ALLOWED_PACKS=
# Public keys trusted to sign your own packs (kitegate-pack keygen), and
# whether unsigned packs are refused. Bundled packs are always checked.
KITEGATE_PACK_KEYS=
KITEGATE_REQUIRE_SIGNED_PACKS=true

# A front end's own system prompt on a children's model. The gateway's system
# message (core framing, then the pack's) is always the only one, and first.
#   fold (default when blank)  the front end's text goes in after it, ranked below
#   drop                       the front end's text is ignored
KITEGATE_CLIENT_SYSTEM=

# Deny-by-default: these accounts are refused on any other model.
KITEGATE_CHILD_USERS=

# Route adults through too (needed for deny-by-default to see every request).
KITEGATE_PASSTHROUGH=false
# Required with passthrough: the ONLY accounts served an unscreened model.
# Anyone not listed here (or in CHILD_USERS) is refused on those models, so a
# child account nobody remembered to list is never given an adult model.
KITEGATE_ADULT_USERS=
# KITEGATE_PASSTHROUGH_URL=https://api.openai.com/v1
# KITEGATE_PASSTHROUGH_API_KEY=

KITEGATE_BLOCK_LOG=/var/lib/kitegate/blocks.jsonl
# Distress events are POSTed here (https only).
KITEGATE_ALERT_WEBHOOK=

# --- Pictures ----------------------------------------------------------------
# What happens to pictures in a reply:
#   scan   from an allowed host, checked by a hosted moderation model, and
#          removed only if they fail. The default when a scan key is set.
#   block  pictures are removed. The default without a key, and worth setting
#          deliberately for a text-only service.
#   allow  shown unchecked, and the host allowlist is not applied.
# Left blank: scan if KITEGATE_IMAGE_SCAN_API_KEY is set below, block if not.
KITEGATE_IMAGE_POLICY=
# Needed for "scan". The endpoint fetches the image itself, so the gateway
# never downloads one. OpenAI's /moderations is free at the time of writing.
KITEGATE_IMAGE_SCAN_URL=https://api.openai.com/v1/moderations
KITEGATE_IMAGE_SCAN_API_KEY=
KITEGATE_IMAGE_SCAN_MODEL=omni-moderation-latest
# Hosts a picture may come from. Blank means the curated photo providers this
# project ships (both Wikimedia hosts and NASA's); anything else is removed
# with no API call, so this is the cheap half of the defence. Add a host here
# if you add a provider. "*" scans whatever arrives, from anywhere.
KITEGATE_IMAGE_HOSTS=
# Optional, e.g. "sexual=0.1,violence=0.6". Lower is stricter. Defaults are
# well below the API's own flagging line; see src/kitegate/images.py.
KITEGATE_IMAGE_THRESHOLDS=
# Where the gateway's own find_photo tool looks, tried in order: wikimedia
# (Wikipedia article lead images; the default when blank), nasa (space only,
# keep it after wikimedia). "off" removes the tool. It is offered to the
# children's model only when pictures can be shown, so it is off with "block".
# Front ends need nothing installed; the gateway needs outbound HTTPS to
# Wikipedia (and NASA, if listed).
KITEGATE_PHOTOS=
# Let children SEND pictures. Off by default, and they are not scanned when
# on: a photo a child uploads may be of the child.
KITEGATE_IMAGE_UPLOADS=
