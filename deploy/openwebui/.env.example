# Written by setup.sh / setup.ps1. Edit and run `docker compose up -d` to apply.
# This file holds keys: never commit it (.env is gitignored).

# Secrets, generated by setup.
KITEGATE_API_KEY=
WEBUI_SECRET_KEY=

# The model. A provider (any OpenAI-compatible API):
KITEGATE_UPSTREAM_URL=https://api.openai.com/v1
KITEGATE_UPSTREAM_API_KEY=
KITEGATE_UPSTREAM_MODEL=gpt-4.1-mini
# ...or a model on this machine (Ollama, no account needed, several GB):
# COMPOSE_PROFILES=local
# KITEGATE_UPSTREAM_URL=http://ollama:11434/v1
# KITEGATE_UPSTREAM_MODEL=llama3.2:3b

# Values pack: secular-neutral, uk-school or christian-family.
KITEGATE_PACK=secular-neutral
# A system prompt set on the model in Open WebUI. Blank folds it in after the
# pack's framing, ranked below it; "drop" ignores it.
KITEGATE_CLIENT_SYSTEM=

# Children's Open WebUI account emails, comma-separated. They can use only
# the kids-encyclopedia model; any other model refuses them.
KITEGATE_CHILD_USERS=

# Optional: https URL that receives distress alerts as JSON.
KITEGATE_ALERT_WEBHOOK=

# Pictures. Children see a picture only if it came from one of the curated
# sources below AND passed a moderation check. The gateway finds them itself
# (its find_photo tool), so there is nothing to install in Open WebUI.
#   scan   check each picture, show the ones that pass
#   block  remove every picture, for a text-only service
#   allow  show pictures unchecked, from any host (not advised)
# Blank, as shipped, means: scan if there is a key below, block if not. Set
# "scan" by hand only with a key, or the gateway stops at startup saying so.
KITEGATE_IMAGE_POLICY=
# Needed for "scan"; blank turns pictures off whatever the policy says. An
# OpenAI key: /moderations is free at the time of writing and fetches the
# image itself, so nothing is downloaded here. setup.sh reuses your provider
# key when the provider is OpenAI.
KITEGATE_IMAGE_SCAN_API_KEY=
# Hosts pictures may come from. Blank means the providers Kitegate ships
# (both Wikimedia hosts, which are needed, and NASA's).
KITEGATE_IMAGE_HOSTS=
# Where the gateway looks for a photograph, tried in order: wikimedia
# (Wikipedia lead images, the default when blank), nasa (space only).
# "off" turns the photo tool off. It is off anyway when pictures are blocked.
KITEGATE_PHOTOS=

# Open WebUI on http://127.0.0.1:<port>
WEBUI_PORT=3000
